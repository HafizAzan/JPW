NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/hirehub
# MONGO_URI is also accepted if you already use that name

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=hirehub_token

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HireHub <noreply@hirehub.dev>
